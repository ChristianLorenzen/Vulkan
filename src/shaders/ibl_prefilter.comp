#version 450
// GGX-convolves the sky cube at one fixed roughness into one mip of the
// prefiltered cube. Dispatched once per mip; roughness comes in as a push
// constant. This is the "split-sum" specular half (Karis 2013).

layout(local_size_x=8,local_size_y=8,local_size_z=1)in;

layout(set=0,binding=0)uniform samplerCube skyCube;
layout(set=0,binding=1,rgba16f)uniform writeonly imageCube outCube;

layout(push_constant)uniform Push{
    uint faceSize;// size of THIS mip
    float roughness;
    uint sampleCount;
    float skyFaceSize;// mip 0 face size of skyCube, for the mip-bias formula
}push;

const float PI=3.14159265359;

vec3 directionForFace(uint face,vec2 uv)
{
    switch(face){
        case 0u:return vec3(1.,-uv.y,-uv.x);
        case 1u:return vec3(-1.,-uv.y,uv.x);
        case 2u:return vec3(uv.x,1.,uv.y);
        case 3u:return vec3(uv.x,-1.,-uv.y);
        case 4u:return vec3(uv.x,-uv.y,1.);
        default:return vec3(-uv.x,-uv.y,-1.);
    }
}

// Van der Corput radical inverse -- the low-discrepancy sequence that makes a
// few hundred samples behave like a few thousand random ones.
float radicalInverseVdC(uint bits)
{
    bits=(bits<<16u)|(bits>>16u);
    bits=((bits&0x55555555u)<<1u)|((bits&0xAAAAAAAAu)>>1u);
    bits=((bits&0x33333333u)<<2u)|((bits&0xCCCCCCCCu)>>2u);
    bits=((bits&0x0F0F0F0Fu)<<4u)|((bits&0xF0F0F0F0u)>>4u);
    bits=((bits&0x00FF00FFu)<<8u)|((bits&0xFF00FF00u)>>8u);
    return float(bits)*2.3283064365386963e-10;
}

vec2 hammersley(uint i,uint n){return vec2(float(i)/float(n),radicalInverseVdC(i));}

vec3 importanceSampleGGX(vec2 Xi,vec3 N,float roughness)
{
    float a=roughness*roughness;
    float phi=2.*PI*Xi.x;
    float cosTheta=sqrt((1.-Xi.y)/(1.+(a*a-1.)*Xi.y));
    float sinTheta=sqrt(1.-cosTheta*cosTheta);
    
    vec3 H=vec3(sinTheta*cos(phi),sinTheta*sin(phi),cosTheta);
    
    vec3 up=abs(N.z)<.999?vec3(0.,0.,1.):vec3(1.,0.,0.);
    vec3 tangent=normalize(cross(up,N));
    vec3 bitangent=cross(N,tangent);
    return normalize(tangent*H.x+bitangent*H.y+N*H.z);
}

float distributionGGX(float NdotH,float roughness)
{
    float a=roughness*roughness;
    float a2=a*a;
    float d=NdotH*NdotH*(a2-1.)+1.;
    return a2/(PI*d*d);
}

void main()
{
    uvec3 id=gl_GlobalInvocationID;
    if(id.x>=push.faceSize||id.y>=push.faceSize)return;
    
    vec2 uv=((vec2(id.xy)+.5)/float(push.faceSize))*2.-1.;
    vec3 N=normalize(directionForFace(id.z,uv));
    // Split-sum assumes the view direction equals the normal. This is the
    // approximation's one real cost: grazing-angle reflections lose their stretch.
    vec3 R=N;
    vec3 V=N;
    
    // Solid angle covered by one source texel, used for the mip bias below.
    float saTexel=4.*PI/(6.*push.skyFaceSize*push.skyFaceSize);
    
    vec3 color=vec3(0.);
    float totalWeight=0.;
    
    for(uint i=0u;i<push.sampleCount;++i){
        vec2 Xi=hammersley(i,push.sampleCount);
        vec3 H=importanceSampleGGX(Xi,N,push.roughness);
        vec3 L=normalize(2.*dot(V,H)*H-V);
        
        float NdotL=dot(N,L);
        if(NdotL<=0.)continue;
        
        // Pick a source mip from the sample's solid angle. Without this a bright
        // sun disc produces fireflies that no realistic sample count averages out.
        float NdotH=max(dot(N,H),0.);
        float pdf=distributionGGX(NdotH,push.roughness)*.25+.0001;
        float saSample=1./(float(push.sampleCount)*pdf+.0001);
        float mipBias=push.roughness==0.?0.
        :.5*log2(saSample/saTexel);
        
        color+=textureLod(skyCube,L,max(mipBias,0.)).rgb*NdotL;
        totalWeight+=NdotL;
    }
    
    imageStore(outCube,ivec3(id),vec4(color/max(totalWeight,.001),1.));
}