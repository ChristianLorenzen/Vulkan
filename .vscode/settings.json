{
    "files.associations": {
        "__split_buffer": "cpp",
        "deque": "cpp",
        "list": "cpp",
        "string": "cpp",
        "vector": "cpp",
        "*.ipp": "cpp"
    },
    "C_Cpp.errorSquiggles": "disabled",
