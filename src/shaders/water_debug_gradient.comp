#version 450
// water_debug_gradient.comp -- Phase 1 smoke test for the compute pipeline path.
//
// Writes an animated UV gradient into a storage image so the VulkanComputePipeline
// (reflection-driven descriptor set + push constants + dispatch) can be exercised and
// visually confirmed end-to-end before any real water compute passes exist.
//
// Bindings (reflected automatically by VulkanComputePipeline -- no manual set layout):
//   set=0 binding=0 : storage image, rgba16f, written via imageStore()
//
// Push constants:
//   time, deltaTime -- globalSetLayout binding 0 is VK_SHADER_STAGE_ALL_GRAPHICS only,
//   so compute shaders can't read GlobalUBO; frame time comes in via push constants
//   instead (see docs/WaterSystemPlan.md Phase 1, "frame time into compute shaders").

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D outputImage;

layout(push_constant) uniform WaterComputeTimePushConstants
{
    float time;
    float deltaTime;
}
push;

void main()
{
    ivec2 imageSize = imageSize(outputImage);
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= imageSize.x || texel.y >= imageSize.y)
    {
        return;
    }

    vec2 uv = (vec2(texel) + 0.5) / vec2(imageSize);

    // Cheap animated pattern: a UV gradient with a moving diagonal band, purely to
    // make it obvious at a glance that the image is (a) compute-written and (b)
    // updating every frame from a live push constant.
    float band = sin((uv.x + uv.y) * 12.0 - push.time * 2.0) * 0.5 + 0.5;
    vec3 color = vec3(uv, band);

    imageStore(outputImage, texel, vec4(color, 1.0));
}
