#version 450
// Cosine-convolves the sky cube into a small irradiance cube: for each output
// direction N, integrate incoming radiance over the hemisphere weighted by
// cos(theta). Output is already divided by PI, so consumers multiply by albedo
// directly and must NOT divide by PI again.

layout(local_size_x=8,local_size_y=8,local_size_z=1)in;

layout(set=0,binding=0)uniform samplerCube skyCube;
layout(set=0,binding=1,rgba16f)uniform writeonly imageCube outCube;

layout(push_constant)uniform Push{
    uint faceSize;
    float sampleDelta;
}push;

const float PI=3.14159265359;

vec3 directionForFace(uint face,vec2 uv)
{
    switch(face){
        case 0u:return vec3(1.,-uv.y,-uv.x);
        case 1u:return vec3(-1.,-uv.y,uv.x);
        case 2u:return vec3(uv.x,1.,uv.y);
        case 3u:return vec3(uv.x,-1.,-uv.y);
        case 4u:return vec3(uv.x,-uv.y,1.);
        default:return vec3(-uv.x,-uv.y,-1.);
    }
}

void main()
{
    uvec3 id=gl_GlobalInvocationID;
    if(id.x>=push.faceSize||id.y>=push.faceSize)return;
    
    vec2 uv=((vec2(id.xy)+.5)/float(push.faceSize))*2.-1.;
    vec3 N=normalize(directionForFace(id.z,uv));
    
    // Tangent frame around N. The up-vector swap avoids a degenerate cross
    // product at the poles.
    vec3 up=abs(N.y)<.999?vec3(0.,1.,0.):vec3(0.,0.,1.);
    vec3 right=normalize(cross(up,N));
    up=normalize(cross(N,right));
    
    vec3 irradiance=vec3(0.);
    float samples=0.;
    
    for(float phi=0.;phi<2.*PI;phi+=push.sampleDelta){
        for(float theta=0.;theta<.5*PI;theta+=push.sampleDelta){
            vec3 tangentSample=vec3(sin(theta)*cos(phi),
            sin(theta)*sin(phi),
            cos(theta));
            vec3 L=tangentSample.x*right+tangentSample.y*up+tangentSample.z*N;
            // Sample a mid mip: the integrand is low-frequency, and mip 0 makes
            // the sun disc alias badly at this sample count.
            irradiance+=textureLod(skyCube,L,3.).rgb*cos(theta)*sin(theta);
            samples+=1.;
        }
    }
    
    // The PI factor and the 1/samples average combine to this constant.
    irradiance=PI*irradiance*(1./samples);
    
    imageStore(outCube,ivec3(id),vec4(irradiance,1.));
}